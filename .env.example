# =============================================================================
# ZHF MULTI-AGENT TRADING SYSTEM - ENVIRONMENT
# Kopiere zu .env und fülle deine Keys ein. .env wird NIE committed.
# =============================================================================

# --- Global ---
ENVIRONMENT=paper                    # paper | live
DRY_RUN=true                         # true = keine echten Orders (empfohlen für Start!)
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
TIMEZONE=Europe/Berlin

# --- OpenCode CLI (PRIMÄR – Zen Free Tier Modelle via opencode.ai) ---
OPENCODE_BIN=opencode                # Pfad zur OpenCode CLI
OPENCODE_TIMEOUT=180                 # Sekunden Timeout pro Aufruf
OPENCODE_DISABLE_TELEMETRY=true      # Telemetrie abschalten
# KEINE API-KEYS NÖTIG! Die Free-Modelle funktionieren ohne Credentials.
# Für Zen-Go (paid) später:
# OPENCODE_API_KEY=zen-xxx           # via opencode providers hinterlegen

# --- Lokaler LLM-Server (FALLBACK – LM Studio / Ollama / llama.cpp / vLLM) ---
# Wird automatisch erkannt auf Ports 1234, 11434, 8080, 8000, wenn LOCAL_LLM_BASE_URL leer ist.
LOCAL_LLM_BASE_URL=                  # Explizite URL, z.B. http://127.0.0.1:1234/v1
LOCAL_LLM_API_KEY=local              # Meist "lm-studio" für LM Studio, "ollama" für Ollama
LOCAL_LLM_TIMEOUT=120

# --- Alpaca (US Stocks, Crypto, Paper Trading) ---
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
ALPACA_PAPER=true                    # true = paper trading
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
# Markt-Daten-Feed: auto|iex = IEX (Gratis-Plan, 1 Venue, Echtzeit), sip = volles SIP (nur
# mit bezahltem Abo). "subscription does not permit querying recent SIP data" im Log
# => Feed auf iex lassen (Default) oder Algo Trader Plus buchen.
ALPACA_DATA_FEED=auto
ALPACA_DROP_PARTIAL_BAR=true         # letzte, noch offene Kerze verwerfen
ALPACA_DATA_MIN_INTERVAL_S=0.35      # Sende-Abstand (Free-Tier: 200 req/min)
ALPACA_MAX_RETRIES=3
ALPACA_EXTENDED_HOURS=false          # vor/nach Börsenschluss handeln?
ALPACA_BRACKET_ORDERS=true           # SL/TP als OTO direkt am Broker

# --- BingX (Crypto Perps/Spot) ---
BINGX_API_KEY=your_bingx_key
BINGX_SECRET_KEY=your_bingx_secret
BINGX_TESTNET=true                   # schaltet ccxt-Sandbox (open-api-vst) EIN;
                                     # dafuer sind Testnet-API-Keys noetig!
BINGX_BASE_URL=                      # leer = ccxt-Standard-Endpoint

# --- Bitunix (Crypto Perps) ---
# Bitunix hat KEIN oeffentliches REST-Testnet (nur "Demo Trading" im Web-UI, ohne
# API). Ein Host wie fapi-sim.bitunix.com existiert nicht. BITUNIX_TESTNET=true
# bedeutet deshalb: read-only (Marktdaten ja, Orders blockiert).
BITUNIX_API_KEY=your_bitunix_key
BITUNIX_SECRET_KEY=your_bitunix_secret
BITUNIX_TESTNET=true
BITUNIX_ALLOW_LIVE_ORDERS=false      # true = echte Orders auf PRODUCTION (VORSICHT)
BITUNIX_BASE_URL=https://fapi.bitunix.com
BITUNIX_MARGIN_COIN=USDT

# --- Risk Limits (vom Board gesetzt) ---
MAX_POSITION_SIZE_PCT=2.0            # max 2% des Portfolio pro Trade
MAX_DAILY_DRAWDOWN_PCT=3.0           # Stopp des Systems nach 3% Tagesverlust
MAX_WEEKLY_DRAWDOWN_PCT=7.0          # Stopp nach 7% Wochenverlust
MAX_OPEN_POSITIONS=8                 # max 8 gleichzeitige Positionen
MAX_LEVERAGE=3                       # max 3x Hebel bei Futures
CORRELATION_LIMIT=0.7                # max Korrelation zwischen Positionen
DEFAULT_STOP_LOSS_PCT=1.5            # Default SL 1.5%
DEFAULT_TAKE_PROFIT_PCT=3.0          # Default TP 3.0 (1:2 RR)
MAX_POSITION_NOTIONAL_PCT=20.0       # max. 20% des Equity als Ordergroesse (Notional!)
MIN_ORDER_NOTIONAL_USD=5.0           # unterhalb lohnt Gebuehr/Slippage nicht
# Gebuehren fuer Backtest + Cost-Optimizer (Realwerte, pro Seite):
#   alpaca stocks 0%, alpaca crypto 0.15%/0.25%, bingx perp 0.02%/0.05%, bitunix 0.02%/0.06%
# Abweichende eigene Sätze hier hinterlegen (JSON, Maker/Taker pro Markt):
# FEE_SCHEDULE_JSON={"bingx":{"crypto_perp":[0.0002,0.0005]}}

# --- Netzwerk-Haertung ---
BROKER_MAX_CONSECUTIVE_ERRORS=3      # danach macht der Broker eine Pause
BROKER_COOLDOWN_S=300
HTTP_TIMEOUT_S=15
HTTP_MAX_RETRIES=3

# --- Paths / Betrieb ---
# ZHF_DATA_DIR isoliert den kompletten Runtime-Zustand (State, Logs, Reports).
# Der Synth-Selbsttest nutzt data/synth, damit Tests die Produktion nicht
# überschreiben (alter Bug: SYNTH_*-Kandidaten landeten in data/signals).
ZHF_DATA_DIR=./data
DATA_DIR=./data                      # Alias, gleiche Bedeutung wie ZHF_DATA_DIR
REPORTS_DIR=                         # leer = <ZHF_DATA_DIR>/reports
LOG_DIR=                             # leer = <ZHF_DATA_DIR>/logs
STRATEGIES_DIR=./strategies
# Offline-Selbsttest ohne Keys/Netz:  ZHF_SYNTH=1 python -m scripts.run_pipeline
ZHF_SYNTH=false
ZHF_SKIP_LLM=false                   # true = deterministisch ohne LLM (Tests)
SYNTH_SEED=42
